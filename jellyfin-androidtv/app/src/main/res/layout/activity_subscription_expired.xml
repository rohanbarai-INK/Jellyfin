<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center"
	android:orientation="vertical"
	android:padding="48dp">

	<TextView
		android:id="@+id/title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/subscription_expired_title"
		android:textColor="@android:color/white"
		android:textSize="36sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/message"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="18dp"
		android:gravity="center"
		android:text="@string/subscription_expired_message"
		android:textColor="@android:color/white"
		android:textSize="20sp" />

	<TextView
		android:id="@+id/renewalPrompt"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="18dp"
		android:gravity="center"
		android:text="@string/subscription_expired_qr_placeholder"
		android:textColor="@android:color/white"
		android:textSize="18sp" />

	<Button
		android:id="@+id/logOutButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="28dp"
		android:text="@string/subscription_expired_log_out" />

</LinearLayout>
